<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
      <groupId>io.github.emilevictor.neoproj4j</groupId>
      <artifactId>neoproj4j-modules</artifactId>
      <version>1.3.1-SNAPSHOT</version>
    </parent>

    <groupId>io.github.emilevictor.neoproj4j</groupId>
    <artifactId>neoproj4j-geoapi</artifactId>
    <packaging>jar</packaging>
    <name>neoProj4J GeoAPI</name>
    <description>GeoAPI wrappers for viewing neoProj4J as a GeoAPI implementation.</description>

    <!-- Repeated rather than inherited: Maven appends this module's artifactId to an inherited
         <url> and <scm>. See the long note in the root POM; keep the values in step with it. -->
    <url>https://github.com/emilevictor/neoProj4J</url>

    <!-- <developers> REPLACES the parent's list, it does not merge with it. Until now this element
         held only Desruisseaux, so the PUBLISHED proj4j-geoapi POM credited him alone and dropped
         the four inherited entries. The parent's list is repeated here so that adding the GeoAPI
         author augments the credits instead of replacing them. Keep the two in step. -->
    <developers>
        <developer>
            <id>echeipesh</id>
            <name>Eugene Cheipesh</name>
            <url>https://github.com/echeipesh</url>
        </developer>
        <developer>
            <id>lossyrob</id>
            <name>Rob Emanuele</name>
            <url>https://github.com/lossyrob</url>
        </developer>
        <developer>
            <id>pomadchin</id>
            <name>Grigory Pomadchin</name>
            <url>https://github.com/pomadchin</url>
        </developer>
        <developer>
            <id>desruisseaux</id>
            <name>Martin Desruisseaux</name>
            <url>https://github.com/desruisseaux</url>
        </developer>
        <developer>
            <id>emilevictor</id>
            <name>Emile Victor</name>
            <url>https://github.com/emilevictor</url>
            <roles>
                <role>neoProj4J fork maintainer</role>
            </roles>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/emilevictor/neoProj4J</url>
        <connection>scm:git:https://github.com/emilevictor/neoProj4J.git</connection>
        <developerConnection>scm:git:git@github.com:emilevictor/neoProj4J.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- Published. -->
        <maven.deploy.skip>false</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.opengis</groupId>
            <artifactId>geoapi</artifactId>
            <version>3.0.2</version>
        </dependency>
        <dependency>
            <groupId>org.opengis</groupId>
            <artifactId>geoapi-conformance</artifactId>
            <version>3.0.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.emilevictor.neoproj4j</groupId>
            <artifactId>neoproj4j</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.emilevictor.neoproj4j</groupId>
            <artifactId>neoproj4j-epsg</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>tech.uom</groupId>
            <artifactId>seshat</artifactId>
            <version>1.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <author>false</author>
                    <noqualifier>all</noqualifier>
                    <quiet>true</quiet>
                    <breakiterator>true</breakiterator>
                    <links>
                        <link>https://www.geoapi.org/3.0/javadoc/</link>
                    </links>
                    <excludePackageNames>org.locationtech.proj4j.geoapi.spi</excludePackageNames>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>org.locationtech.proj4j.geoapi</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
