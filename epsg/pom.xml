<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
      <groupId>io.github.emilevictor.neoproj4j</groupId>
      <artifactId>neoproj4j-modules</artifactId>
      <version>1.3.1-SNAPSHOT</version>
    </parent>

    <groupId>io.github.emilevictor.neoproj4j</groupId>
    <artifactId>neoproj4j-epsg</artifactId>
    <packaging>jar</packaging>
    <name>neoProj4J EPSG</name>
    <description>EPSG, ESRI, world, NAD83 and NAD27 init dictionaries for neoProj4J, plus PROJ's
        `conus` CTABLE V2 grid.</description>

    <!-- Repeated rather than inherited: Maven appends this module's artifactId to an inherited
         <url> and <scm>. See the long note in the root POM; keep the values in step with it. -->
    <url>https://github.com/emilevictor/neoProj4J</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
        <license>
            <name>EPSG database distribution license</name>
            <url>https://raw.githubusercontent.com/emilevictor/neoProj4J/develop/LICENSE.EPSG</url>
        </license>
        <!-- Covers proj4/nad/conus, redistributed verbatim from PROJ 9.8.1 data/tests/conus
             (blob 44b4900f3168a5b87794f41d201d03d5aea0b964). PROJ's COPYING places data files
             under the same MIT terms as its source. -->
        <license>
            <name>MIT License (PROJ)</name>
            <url>https://raw.githubusercontent.com/emilevictor/neoProj4J/develop/LICENSE.PROJ</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/emilevictor/neoProj4J</url>
        <connection>scm:git:https://github.com/emilevictor/neoProj4J.git</connection>
        <developerConnection>scm:git:git@github.com:emilevictor/neoProj4J.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- Published. -->
        <maven.deploy.skip>false</maven.deploy.skip>
    </properties>

    <build>
        <plugins>
            <!-- Both notices travel with the artifact rather than only being referenced from it: a
                 consumer who has the jar and nothing else still has the terms.

                 LICENSE.PROJ - MIT requires the notice to accompany the file, and this jar carries
                 PROJ's `conus` grid.

                 LICENSE.EPSG - this jar ships EPSG-derived data, and the EPSG Terms of Use clause
                 6.1 obliges the redistributor to "inform anyone to whom you provide the EPSG
                 Facilities of these Terms of Use". A URL in the POM does not inform a consumer who
                 has only the jar. -->
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>embed-licenses</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/..</directory>
                                    <includes>
                                        <include>LICENSE.PROJ</include>
                                        <include>LICENSE.EPSG</include>
                                    </includes>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>org.locationtech.proj4j.epsg</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
